DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Asia/Tashkent

POSTGRES_DB=gymcrm
POSTGRES_USER=gymcrm
POSTGRES_PASSWORD=gymcrm
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# Set to True to run manage.py commands locally against SQLite
# without needing Postgres (useful for quick tests).
USE_SQLITE=False
